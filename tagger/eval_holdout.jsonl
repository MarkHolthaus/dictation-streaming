{"id": 1, "text": "So, um, I was thinking we could grab dinner on Thursday, no, sorry, Friday.", "words": ["So,", "um,", "I", "was", "thinking", "we", "could", "grab", "dinner", "on", "Thursday,", "no,", "sorry,", "Friday."], "labels": ["D", "D", "K", "K", "K", "K", "K", "K", "K", "K", "D", "D", "D", "K"]}
{"id": 2, "text": "Can you can you send me the link to the the spreadsheet?", "words": ["Can", "you", "can", "you", "send", "me", "the", "link", "to", "the", "the", "spreadsheet?"], "labels": ["D", "D", "K", "K", "K", "K", "K", "K", "K", "D", "K", "K"]}
{"id": 3, "text": "I told her, him, him that the uh, shipment was late.", "words": ["I", "told", "her,", "him,", "him", "that", "the", "uh,", "shipment", "was", "late."], "labels": ["K", "K", "D", "D", "K", "K", "K", "D", "K", "K", "K"]}
{"id": 4, "text": "The class starts at nine. Actually, make that nine thirty.", "words": ["The", "class", "starts", "at", "nine.", "Actually,", "make", "that", "nine", "thirty."], "labels": ["K", "K", "K", "K", "K", "E", "E", "E", "E", "E"]}
{"id": 5, "text": "We're going to need like, twelve chairs and um, four tables.", "words": ["We're", "going", "to", "need", "like,", "twelve", "chairs", "and", "um,", "four", "tables."], "labels": ["K", "K", "K", "K", "D", "K", "K", "K", "D", "K", "K"]}
{"id": 6, "text": "I really like how the the new layout turned out.", "words": ["I", "really", "like", "how", "the", "the", "new", "layout", "turned", "out."], "labels": ["K", "K", "K", "K", "D", "K", "K", "K", "K", "K"]}
{"id": 7, "text": "It looks like it's it's going to be a busy week.", "words": ["It", "looks", "like", "it's", "it's", "going", "to", "be", "a", "busy", "week."], "labels": ["K", "K", "K", "D", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 8, "text": "You know that feeling when you you forget what you walked into a room for?", "words": ["You", "know", "that", "feeling", "when", "you", "you", "forget", "what", "you", "walked", "into", "a", "room", "for?"], "labels": ["K", "K", "K", "K", "K", "D", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 9, "text": "Let's grab lunch on Monday, or rather, Tuesday.", "words": ["Let's", "grab", "lunch", "on", "Monday,", "or", "rather,", "Tuesday."], "labels": ["K", "K", "K", "K", "D", "D", "D", "K"]}
{"id": 10, "text": "I paid thirty, thirty-five, thirty-five dollars for the ticket.", "words": ["I", "paid", "thirty,", "thirty-five,", "thirty-five", "dollars", "for", "the", "ticket."], "labels": ["K", "K", "D", "D", "K", "K", "K", "K", "K"]}
{"id": 11, "text": "Honestly, I don't know what to do this weekend.", "words": ["Honestly,", "I", "don't", "know", "what", "to", "do", "this", "weekend."], "labels": ["K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 12, "text": "Send the report to Dana, wait, Priya by end of day.", "words": ["Send", "the", "report", "to", "Dana,", "wait,", "Priya", "by", "end", "of", "day."], "labels": ["K", "K", "K", "K", "D", "D", "K", "K", "K", "K", "K"]}
{"id": 13, "text": "Uh, yeah, I can do that.", "words": ["Uh,", "yeah,", "I", "can", "do", "that."], "labels": ["D", "K", "K", "K", "K", "K"]}
{"id": 14, "text": "My flight is on the 14th. Make that the 15th.", "words": ["My", "flight", "is", "on", "the", "14th.", "Make", "that", "the", "15th."], "labels": ["K", "K", "K", "K", "K", "K", "E", "E", "E", "E"]}
{"id": 15, "text": "We should look at the the numbers again before we we send anything out.", "words": ["We", "should", "look", "at", "the", "the", "numbers", "again", "before", "we", "we", "send", "anything", "out."], "labels": ["K", "K", "K", "K", "D", "K", "K", "K", "K", "D", "K", "K", "K", "K"]}
{"id": 16, "text": "Tell Mike the meeting is in room two ten, no, two twelve.", "words": ["Tell", "Mike", "the", "meeting", "is", "in", "room", "two", "ten,", "no,", "two", "twelve."], "labels": ["K", "K", "K", "K", "K", "K", "K", "D", "D", "D", "K", "K"]}
{"id": 17, "text": "Okay, um, so first we need to to call the vendor.", "words": ["Okay,", "um,", "so", "first", "we", "need", "to", "to", "call", "the", "vendor."], "labels": ["K", "D", "K", "K", "K", "K", "D", "K", "K", "K", "K"]}
{"id": 18, "text": "I'm not sure it's it's worth it, you know, given the cost.", "words": ["I'm", "not", "sure", "it's", "it's", "worth", "it,", "you", "know,", "given", "the", "cost."], "labels": ["K", "K", "K", "D", "K", "K", "K", "D", "D", "K", "K", "K"]}
{"id": 19, "text": "She said she'd call back in five, ten, ten minutes.", "words": ["She", "said", "she'd", "call", "back", "in", "five,", "ten,", "ten", "minutes."], "labels": ["K", "K", "K", "K", "K", "K", "D", "D", "K", "K"]}
{"id": 20, "text": "Please put the boxes in the garage. Sorry, I meant the basement.", "words": ["Please", "put", "the", "boxes", "in", "the", "garage.", "Sorry,", "I", "meant", "the", "basement."], "labels": ["K", "K", "K", "K", "K", "K", "K", "E", "E", "E", "E", "E"]}
{"id": 21, "text": "It tastes like chicken, honestly.", "words": ["It", "tastes", "like", "chicken,", "honestly."], "labels": ["K", "K", "K", "K", "K"]}
{"id": 22, "text": "I'd like to uh, schedule a call for next week.", "words": ["I'd", "like", "to", "uh,", "schedule", "a", "call", "for", "next", "week."], "labels": ["K", "K", "K", "D", "K", "K", "K", "K", "K", "K"]}
{"id": 23, "text": "He he said no, so so we're going with the other vendor.", "words": ["He", "he", "said", "no,", "so", "so", "we're", "going", "with", "the", "other", "vendor."], "labels": ["D", "K", "K", "K", "D", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 24, "text": "What time does the, um, does the store close on Sundays?", "words": ["What", "time", "does", "the,", "um,", "does", "the", "store", "close", "on", "Sundays?"], "labels": ["K", "K", "D", "D", "D", "K", "K", "K", "K", "K", "K"]}
{"id": 25, "text": "I need a a ride to the airport on Saturday.", "words": ["I", "need", "a", "a", "ride", "to", "the", "airport", "on", "Saturday."], "labels": ["K", "K", "D", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 26, "text": "Wait, did you say Tuesday or Thursday?", "words": ["Wait,", "did", "you", "say", "Tuesday", "or", "Thursday?"], "labels": ["K", "K", "K", "K", "K", "K", "K"]}
{"id": 27, "text": "The invoice is four hundred, sorry, four fifty.", "words": ["The", "invoice", "is", "four", "hundred,", "sorry,", "four", "fifty."], "labels": ["K", "K", "K", "D", "D", "D", "K", "K"]}
{"id": 28, "text": "I think we, we should wait until the end of the month.", "words": ["I", "think", "we,", "we", "should", "wait", "until", "the", "end", "of", "the", "month."], "labels": ["K", "K", "D", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 29, "text": "Add bananas to the list. Change that to oranges.", "words": ["Add", "bananas", "to", "the", "list.", "Change", "that", "to", "oranges."], "labels": ["K", "K", "K", "K", "K", "E", "E", "E", "E"]}
