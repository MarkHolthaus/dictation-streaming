{"id": 1, "text": "Um, so I think we should, uh, meet at three on Tuesday. Actually, no, Wednesday.", "words": ["Um,", "so", "I", "think", "we", "should,", "uh,", "meet", "at", "three", "on", "Tuesday.", "Actually,", "no,", "Wednesday."], "labels": ["D", "K", "K", "K", "K", "K", "D", "K", "K", "K", "K", "D", "D", "D", "K"]}
{"id": 2, "text": "Let's get lunch on Monday. Wait, no, Tuesday.", "words": ["Let's", "get", "lunch", "on", "Monday.", "Wait,", "no,", "Tuesday."], "labels": ["K", "K", "K", "K", "D", "D", "D", "K"]}
{"id": 3, "text": "The call is at two. Sorry, three.", "words": ["The", "call", "is", "at", "two.", "Sorry,", "three."], "labels": ["K", "K", "K", "K", "D", "D", "K"]}
{"id": 4, "text": "Please send it to Pat. No, wait, Jake.", "words": ["Please", "send", "it", "to", "Pat.", "No,", "wait,", "Jake."], "labels": ["K", "K", "K", "K", "D", "D", "D", "K"]}
{"id": 5, "text": "I'll bring four chairs. I mean six chairs.", "words": ["I'll", "bring", "four", "chairs.", "I", "mean", "six", "chairs."], "labels": ["K", "K", "D", "D", "D", "D", "K", "K"]}
{"id": 6, "text": "Tell him. Actually, no, her that the keys are here.", "words": ["Tell", "him.", "Actually,", "no,", "her", "that", "the", "keys", "are", "here."], "labels": ["K", "D", "D", "D", "K", "K", "K", "K", "K", "K"]}
{"id": 7, "text": "The deadline is the 5th. Actually, no, the 12th.", "words": ["The", "deadline", "is", "the", "5th.", "Actually,", "no,", "the", "12th."], "labels": ["K", "K", "K", "D", "D", "D", "D", "K", "K"]}
{"id": 8, "text": "Our flight leaves on Thursday. Sorry, Friday morning.", "words": ["Our", "flight", "leaves", "on", "Thursday.", "Sorry,", "Friday", "morning."], "labels": ["K", "K", "K", "K", "D", "D", "K", "K"]}
{"id": 9, "text": "I need the red one. No, wait, blue one.", "words": ["I", "need", "the", "red", "one.", "No,", "wait,", "blue", "one."], "labels": ["K", "K", "K", "D", "D", "D", "D", "K", "K"]}
{"id": 10, "text": "We're meeting at the library. Actually, no, the cafe.", "words": ["We're", "meeting", "at", "the", "library.", "Actually,", "no,", "the", "cafe."], "labels": ["K", "K", "K", "D", "D", "D", "D", "K", "K"]}
{"id": 11, "text": "The report is great. Actually, no, it needs more work.", "words": ["The", "report", "is", "great.", "Actually,", "no,", "it", "needs", "more", "work."], "labels": ["K", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 12, "text": "I think we should go. Wait, no, I forgot the tickets are at home.", "words": ["I", "think", "we", "should", "go.", "Wait,", "no,", "I", "forgot", "the", "tickets", "are", "at", "home."], "labels": ["K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 13, "text": "That sounds fine to me. Sorry, I have to run to class.", "words": ["That", "sounds", "fine", "to", "me.", "Sorry,", "I", "have", "to", "run", "to", "class."], "labels": ["K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
{"id": 14, "text": "She said she'd come on Friday. Actually, I'm not sure that's true.", "words": ["She", "said", "she'd", "come", "on", "Friday.", "Actually,", "I'm", "not", "sure", "that's", "true."], "labels": ["K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K", "K"]}
